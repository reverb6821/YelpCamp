<% include ../partials/header %> 

<!-- header -->
<header class="img-header">
    <div class="container h-100">
        <div class="row h-100 align-items-center">
            <div class="col-12 text-center w-100 text-white">
                <h1 class="font-weight-light" color="blue">YelpCamp</h1>
                <p class="lead">Go down for all campgrounds</p>
                <p>
                    <a class="btn btn-primary btn-large" href="/campgrounds/new">Add New Campground</a>
                </p>
            </div>
        </div>
    </div>
</header>

<!-- Core Page -->
<div class="d-flex flex-row bd-highlight mb-3">
    <% campgrounds.forEach(function(campground){ %>
        <div class="card" style="width: 18rem; margin:15px;">
            <img class="card-img-top" src="<%= campground.image %>" alt="Card image cap">             
            <div class="card-body">
                <h5 class="card-title"><%= campground.name %></h5>
                <a href="/campgrounds/<%= campground._id %>" class="btn btn-primary">Go somewhere</a>
            </div>
        </div>
    <% }); %>              
</div>        

<% include ../partials/footer %>
